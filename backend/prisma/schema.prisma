generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusConta {
  PENDENTE
  PAGA
  ATRASADA
}

enum TipoConta {
  AVULSA
  RECORRENTE
}

model Usuario {
  id           String     @id @default(uuid())
  nome         String
  email        String     @unique
  senhaHash    String     @map("senha_hash")
  contas       Conta[]
  mensagens    Mensagem[]
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

model Conta {
  id           String      @id @default(uuid())
  usuarioId    String      @map("usuario_id")
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  descricao    String
  valor        Decimal     @db.Decimal(12, 2)
  vencimento   DateTime
  tipo         TipoConta   @default(AVULSA)
  origemId String? @unique @map("origem_id")
  origem Conta? @relation("Lancamentos", fields: [origemId], references: [id], onDelete: Restrict)
  proxima Conta? @relation("Lancamentos")
  diaRecorrencia Int? @map("dia_recorrencia")
  recorrencia  String?
  recorrenciaAtiva Boolean @default(true) @map("recorrencia_ativa")
  status       StatusConta @default(PENDENTE)
  pagamentos   Pagamento[]
  avisos       Aviso[]
  mensagens    Mensagem[]
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  @@index([usuarioId, vencimento])
  @@map("contas")
}

model Pagamento {
  chave String? @unique
  id       String   @id @default(uuid())
  contaId  String   @map("conta_id")
  conta    Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  valor    Decimal  @db.Decimal(12, 2)
  pagoEm   DateTime @map("pago_em")
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([contaId])
  @@map("pagamentos")
}

model Aviso {
  id            String    @id @default(uuid())
  contaId       String    @map("conta_id")
  conta         Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  diasAntes     Int       @map("dias_antes")
  tipo          String    @default("VENCIMENTO")
  agendadoPara  DateTime  @map("agendado_para")
  enviadoEm     DateTime? @map("enviado_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  @@index([contaId, agendadoPara])
  @@unique([contaId, tipo, agendadoPara])
  @@map("avisos")
}

model Mensagem {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  conteudo  String
  lida      Boolean  @default(false)
  tipo      String   @default("AVISO")
  chave     String?  @unique
  contaId   String?  @map("conta_id")
  conta     Conta?   @relation(fields: [contaId], references: [id], onDelete: SetNull)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([usuarioId, criadoEm])
  @@map("mensagens")
}

model TaxaReferencia {
  chave String @id
  taxaAnual Decimal @db.Decimal(12, 6) @map("taxa_anual")
  fonte String
  referencia DateTime?
  consultadaEm DateTime @map("consultada_em")
  @@map("taxas_referencia")
}

model ExecucaoJob {
  chave String @id
  concluidoEm DateTime @map("concluido_em")
  @@map("execucoes_jobs")
}
