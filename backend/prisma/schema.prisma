generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusConta {
  PENDENTE
  PAGA
  ATRASADA
}

enum TipoConta {
  AVULSA
  RECORRENTE
}

enum CategoriaConta {
  MORADIA
  ESTUDOS
  TRANSPORTE
  SAUDE
  ASSINATURAS
  ALIMENTACAO
  LAZER
  OUTRAS
}

model Usuario {
  id           String     @id @default(uuid())
  nome         String
  email        String     @unique
  senhaHash    String     @map("senha_hash")
  contas       Conta[]
  mensagens    Mensagem[]
  canais CanalUsuario[]
  preferencias PreferenciaUsuario?
  historico HistoricoConta[]
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

model Conta {
  id           String      @id @default(uuid())
  usuarioId    String      @map("usuario_id")
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  descricao    String
  categoria CategoriaConta @default(OUTRAS)
  valor        Decimal     @db.Decimal(12, 2)
  vencimento   DateTime
  tipo         TipoConta   @default(AVULSA)
  origemId String? @unique @map("origem_id")
  origem Conta? @relation("Lancamentos", fields: [origemId], references: [id], onDelete: Restrict)
  proxima Conta? @relation("Lancamentos")
  diaRecorrencia Int? @map("dia_recorrencia")
  recorrencia  String?
  recorrenciaAtiva Boolean @default(true) @map("recorrencia_ativa")
  status       StatusConta @default(PENDENTE)
  pagamentos   Pagamento[]
  avisos       Aviso[]
  mensagens    Mensagem[]
  historico HistoricoConta[]
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  @@index([usuarioId, vencimento])
  @@map("contas")
}

model Pagamento {
  chave String? @unique
  id       String   @id @default(uuid())
  contaId  String   @map("conta_id")
  conta    Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  valor    Decimal  @db.Decimal(12, 2)
  encargos Decimal @default(0) @db.Decimal(12, 2)
  pagoEm   DateTime @map("pago_em")
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([contaId])
  @@map("pagamentos")
}

model Aviso {
  id            String    @id @default(uuid())
  contaId       String    @map("conta_id")
  conta         Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  diasAntes     Int       @map("dias_antes")
  tipo          String    @default("VENCIMENTO")
  agendadoPara  DateTime  @map("agendado_para")
  enviadoEm     DateTime? @map("enviado_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  @@index([contaId, agendadoPara])
  @@unique([contaId, tipo, agendadoPara])
  @@map("avisos")
}

model Mensagem {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  conteudo  String
  lida      Boolean  @default(false)
  tipo      String   @default("AVISO")
  chave     String?  @unique
  contaId   String?  @map("conta_id")
  conta     Conta?   @relation(fields: [contaId], references: [id], onDelete: SetNull)
  criadoEm  DateTime @default(now()) @map("criado_em")
  plataforma String @default("INTERNA")
  direcao String @default("saida")
  estado String @default("enviada") @map("status")
  canalId String? @map("canal_usuario_id")
  canal CanalUsuario? @relation(fields: [canalId], references: [id], onDelete: SetNull)
  idExterno String? @unique @map("id_externo")
  interacaoId String? @unique @map("interacao_id")
  payloadBruto Json? @map("payload_bruto")
  codigoErro String? @map("erro_codigo")
  descricaoErro String? @map("erro_descricao")
  enviadoEm DateTime? @map("enviado_em")
  respondidoEm DateTime? @map("respondido_em")
  tentativas Int @default(0)
  proximaTentativa DateTime @default(now()) @map("proxima_tentativa")

  @@index([plataforma, estado, proximaTentativa])

  @@index([usuarioId, criadoEm])
  @@map("mensagens")
}

model CanalUsuario {
  id String @id @default(uuid())
  usuarioId String @unique @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plataforma String @default("DISCORD")
  discordId String? @unique @map("chat_id")
  codigoConvite String? @unique @map("codigo_convite")
  expiraEm DateTime? @map("expira_em")
  ativo Boolean @default(false)
  vinculadoEm DateTime? @map("vinculado_em")
  erro String?
  mensagens Mensagem[]
  criadoEm DateTime @default(now()) @map("criado_em")
  @@map("canais_usuario")
}

// Inbox durável também guarda eventos de pessoas ainda não vinculadas.
// Token de continuação cifrado; payload sanitizado nunca contém token/código.
model InteracaoDiscord {
  id String @id
  discordId String @map("discord_id")
  payload Json
  segredo String?
  resposta Json?
  processado Boolean @default(false)
  concluido Boolean @default(false)
  tentativas Int @default(0)
  proximaTentativa DateTime @default(now()) @map("proxima_tentativa")
  criadoEm DateTime @default(now()) @map("criado_em")
  @@index([concluido, proximaTentativa])
  @@map("interacoes_discord")
}

model ControleDiscord {
  chave String @id
  pausadoAte DateTime @map("pausado_ate")
  @@map("controle_discord")
}

model TaxaReferencia {
  chave String @id
  taxaAnual Decimal @db.Decimal(12, 6) @map("taxa_anual")
  fonte String
  referencia DateTime?
  consultadaEm DateTime @map("consultada_em")
  @@map("taxas_referencia")
}

model ExecucaoJob {
  chave String @id
  concluidoEm DateTime @map("concluido_em")
  @@map("execucoes_jobs")
}

model PreferenciaUsuario {
  usuarioId String @id @map("usuario_id")
  usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade)
  ordenacaoContas String @default("vencimento") @map("ordenacao_contas")
  confirmarPagamento Boolean @default(true) @map("confirmar_pagamento")
  reduzirMovimento Boolean @default(false) @map("reduzir_movimento")
  tipoContaPadrao TipoConta @default(AVULSA) @map("tipo_conta_padrao")
  categoriaPadrao CategoriaConta @default(OUTRAS) @map("categoria_padrao")
  inicioSemana Int @default(0) @map("inicio_semana")
  detalhesRelatorio Boolean @default(true) @map("detalhes_relatorio")
  @@map("preferencias_usuarios")
}

model HistoricoConta {
  id String @id @default(uuid())
  chave String? @unique
  usuarioId String @map("usuario_id")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contaId String? @map("conta_id")
  conta Conta? @relation(fields: [contaId], references: [id], onDelete: SetNull)
  descricao String
  acao String
  detalhes Json
  criadoEm DateTime @default(now()) @map("criado_em")
  @@index([usuarioId, criadoEm])
  @@index([contaId, criadoEm])
  @@map("historico_contas")
}
