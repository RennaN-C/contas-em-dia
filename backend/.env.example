PORT=3000
DATABASE_URL="postgresql://contasedia:contasedia_local@localhost:5432/contasedia?schema=public"
JWT_SECRET="troque-esta-chave-em-desenvolvimento"
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174"
TRUST_PROXY_HOPS=0

# Novo bot exclusivo SaldoPlusBot. Nunca use credenciais do bot da aula.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Gere 32 bytes hex (64 caracteres) para cifrar tokens temporários da inbox.
DISCORD_ENCRYPTION_KEY=

METRICS_ENABLED=false
METRICS_TOKEN=
# Somente para npm run demo (não usar em produção).
DEMO_EMAIL="apresentacao@saldo.local"
DEMO_PASSWORD="defina-uma-senha-local-de-pelo-menos-8-caracteres"
